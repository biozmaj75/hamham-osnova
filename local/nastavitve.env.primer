# Nastavitve lokalnega strežnika Dom Obroki.
# Kopirajte to datoteko v "nastavitve.env" (v isti mapi) in popravite vrednosti.

# Povezava na bazo PostgreSQL: postgres://UPORABNIK:GESLO@STREŽNIK:VRATA/BAZA
# GESLO zamenjajte z geslom, ki ste ga določili uporabniku "obroki" (glejte Kakoinstaliram.pdf).
DATABASE_URL=postgres://obroki:GESLO@localhost:5432/obroki

# Baza na istem računalniku ali v lokalnem omrežju nima šifrirane povezave
DATABASE_SSL=off

# Kje je aplikacija dosegljiva (glejte Mreža.pdf):
#   127.0.0.1  samo na tem računalniku
#   0.0.0.0    tudi z drugih računalnikov v omrežju
HOST=127.0.0.1
PORT=8080
