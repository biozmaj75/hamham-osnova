# systemd storitev: Dom Obroki se zažene ob vklopu strežnika in se po napaki znova zažene.
# Namestitev (glejte Kakoinstaliram.pdf):
#   sudo cp /opt/dom-obroki/local/dom-obroki.service /etc/systemd/system/
#   sudo systemctl enable --now dom-obroki
[Unit]
Description=Dom Obroki
After=network.target postgresql.service

[Service]
User=obroki
WorkingDirectory=/opt/dom-obroki
ExecStart=/usr/bin/node local/server.mjs
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
